<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
    PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="ajax">
    
    <select id="countAddress" resultType="int">
        select count(*) from tblAddress
    </select>
    
    <select id="getName" resultType="string">
        select name from tblAddress where seq = #{_parameter}
    </select>
    
    <select id="checkId" parameterType="string" resultType="int">
        select count(*) from tblUser where id = #{_parameter}
    </select>
    
    <select id="listUser" resultType="com.test.ajax.model.UserDto">
        select * from tblUser
    </select>
    
    <select id="list" resultType="com.test.ajax.model.AddressDto">
        select a.* from (select * from tblAddress order by seq desc) a
            where rownum &lt;= 5
    </select>
    
    <insert id="add" parameterType="com.test.ajax.model.AddressDto">
        insert into tblAddress
            values (seqAddress.nextVal, #{name}, #{age}, #{address}, #{gender})
    </insert>
    
    <delete id="del" parameterType="string">
        delete from tblAddress where seq = #{_parameter}
    </delete>
    
    <select id="more" parameterType="map" resultType="com.test.ajax.model.AddressDto">
    
        select * from
            (select a.*, rownum as rnum from 
                (select * from tblAddress order by seq desc) a)
        where rnum between #{begin} and #{end}            
            
    </select>
    
</mapper>











