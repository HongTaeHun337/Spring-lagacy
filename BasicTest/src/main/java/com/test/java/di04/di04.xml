<?xml version="1.0" encoding="UTF-8"?>

<beans xmlns="http://www.springframework.org/schema/beans"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.springframework.org/schema/beans
        http://www.springframework.org/schema/beans/spring-beans.xsd">

	<!-- context.getBean("hong") > new Hong() 호출 -->
	<bean class="com.test.java.di04.Hong" id="hong"></bean>
	
	<bean class="com.test.java.di04.Lee" id="lee"></bean>
	
	<!-- context.getBean("service") > new Service() 호출 -->
	
	<!-- Spring DI -->
	<bean class="com.test.java.di04.Service" id="service">
	
		<!-- 순수하게 Path로
		<constructor-arg>
			<bean class="com.test.java.di04.Hong"></bean>
		</constructor-arg> 
		-->
		
		
		<!-- ref안에 id를 적어 부름
		 <constructor-arg ref="hong"></constructor-arg> 
		-->
		
		<!-- setEmployee -->
		<!-- <property name="employee" ref="hong"></property> -->
		<property name="employee" ref="lee"></property>
		
	</bean>
		

</beans>